[Unit]
Description=MiniRedis In-Memory Database Server
Documentation=https://github.com/krishna18gupta/miniredis-java
After=network.target

[Service]
Type=simple
User=miniredis
Group=miniredis
WorkingDirectory=/var/lib/miniredis

# Production JVM options for Java 17
Environment="JAVA_OPTS=-Xms128m -Xmx512m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError"
Environment="MINIREDIS_AOF_DIR=/var/lib/miniredis"
Environment="MINIREDIS_DEMO_MODE=true"
# Optional: Set an administrative secret token for protected commands
# Environment="MINIREDIS_ADMIN_TOKEN=your_secure_random_token_here"

ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/miniredis/miniredis-java-1.0.0.jar --dir /var/lib/miniredis --demo
ExecStop=/bin/kill -s TERM $MAINPID

# Graceful shutdown wait time allowing in-flight AOF fsyncs to flush cleanly
TimeoutStopSec=15
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/miniredis

[Install]
WantedBy=multi-user.target
